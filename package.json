{
  "name": "@luicciandev/drillhole-cli",
  "version": "1.0.6",
  "description": "CLI tool for processing drillhole data (.csv/.txt) and generating Vulcan-ready reports for the mining industry",
  "type": "module",
  "author": "LuiccianDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuiccianDev/drillhole-cli.git"
  },
  "homepage": "https://github.com/LuiccianDev/drillhole-cli#readme",
  "bugs": {
    "url": "https://github.com/LuiccianDev/drillhole-cli/issues"
  },
  "bin": {
    "drill": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "drillhole",
    "mining",
    "vulcan",
    "geology",
    "drilling",
    "assay",
    "lithology",
    "collar",
    "cli",
    "csv",
    "maptek"
  ],
  "scripts": {
    "drill": "tsx src/index.ts",
    "build": "tsc",
    "test": "tsx tests/run.ts",
    "prepublishOnly": "pnpm build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "figlet": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
